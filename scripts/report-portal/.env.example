# Environment variables used by the Report Portal scripts (scripts/report-portal/**).
#
# HOW TO USE:
#   Copy this file to the REPO ROOT `.env`:
#     cp scripts/report-portal/.env.example .env
#   Then fill in the real values below. `.env` is git-ignored.

# Report Portal API token, used for the flaky-detection + history-stats calls
# (client baseURL/project is hardcoded to cypress-nightly in scripts/report-portal/client.js).
CI_API_KEY=

# Base64 of "email:api_token" for Jira Cloud, sent as an HTTP Basic Authorization
# header (see scripts/helpers/api.client.js createJiraClient). Generate an API
# token at https://id.atlassian.com/manage-profile/security/api-tokens, then:
#   echo -n "you@example.com:<api_token>" | base64
JIRA_API_KEY=

# Tracking feature/epic key that flaky-test tasks are linked to, e.g. UXPROD-5976.
# Overridable per run with --epic. If empty, the run logs a loud warning that
# flaky-test tasks were not created/updated.
JIRA_EPIC=

# Comma-separated team names to run the matrix for, e.g. Firebird,Corsair.
# Default (if unset): Firebird,Corsair.
TEAMS=

# Comma-separated Report Portal launch names to run the matrix against.
# Default (if unset): all launches supported by LAUNCHES in
# scripts/report-portal/constants/constants.js.
LAUNCHES=

# Max launch x team combinations to run in parallel. Default (if unset): 4.
CONCURRENCY=

# Set to "true" (or "1") to actually transition stable flaky tickets to Closed
# once their test has passed STABLE_STREAK_THRESHOLD consecutive runs. OFF by
# default (a stable ticket is reported but left open) — closing Jira tickets
# is hard to reverse, so this must be opted into explicitly, here or via
# --auto-close-stable. See scripts/report-portal/README-dailyMatrix.md.
JIRA_FLAKY_AUTO_CLOSE=

# Optional overrides for the Jira project/issue-type/link-type/reopen-status
# the flaky-ticket automation uses. Defaults shown are what the code falls
# back to when these are unset — only set them if your Jira setup differs.
JIRA_FLAKY_PROJECT=FAT
JIRA_FLAKY_ISSUETYPE=Task
JIRA_FLAKY_LINK_TYPE=Relates
JIRA_FLAKY_REOPEN_STATUS=Open
